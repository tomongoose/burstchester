rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: 본인만 자기 프로필 쓰기. 누구나 공개 프로필 읽기.
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.uploadCount == 0
                    && request.resource.data.downloadCount == 0
                    && request.resource.data.reputation == 0;
      allow update: if request.auth.uid == uid
                    && !( "uploadCount" in request.resource.data.diff(resource.data).affectedKeys() )
                    && !( "downloadCount" in request.resource.data.diff(resource.data).affectedKeys() )
                    && !( "reputation" in request.resource.data.diff(resource.data).affectedKeys() );
      allow delete: if false;
    }

    // Datasets: active만 공개 read. 카운터·집계 필드는 클라이언트 직접 변경 불가.
    match /datasets/{id} {
      allow read: if resource.data.status == "active"
                  || (request.auth != null && request.auth.uid == resource.data.ownerUid);

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 80
                    && request.resource.data.tags is list
                    && request.resource.data.tags.size() <= 10
                    && request.resource.data.likeCount == 0
                    && request.resource.data.downloadCount == 0
                    && request.resource.data.reportCount == 0;

      allow update: if request.auth.uid == resource.data.ownerUid
                    && !( "likeCount" in request.resource.data.diff(resource.data).affectedKeys() )
                    && !( "downloadCount" in request.resource.data.diff(resource.data).affectedKeys() )
                    && !( "reportCount" in request.resource.data.diff(resource.data).affectedKeys() )
                    && !( "status" in request.resource.data.diff(resource.data).affectedKeys() );

      allow delete: if request.auth.uid == resource.data.ownerUid;

      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }

      match /reports/{uid} {
        allow read: if request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Tags: 읽기 공개. 쓰기는 Cloud Function만 (admin SDK는 Rules 우회).
    match /tags/{name} {
      allow read: if true;
      allow write: if false;
    }
  }
}
