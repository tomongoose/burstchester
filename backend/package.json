{
  "name": "burstchester-backend",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project burstchester-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^20.0.0",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "^15.16.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
