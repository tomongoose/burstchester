# Firebase client config — populate from Firebase Console > Project Settings > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "1" during local development to route SDK calls to emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=0

# Optional explicit backend base URL for public dataset APIs.
# Example: https://us-central1-your-project.cloudfunctions.net
NEXT_PUBLIC_LIST_DATASETS_URL=
