rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Dataset 업로드: 인증된 본인만 자기 경로에 100MB 이하 jsonl 업로드.
    match /datasets/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 100 * 1024 * 1024
                   && (request.resource.contentType == "application/jsonl"
                       || request.resource.contentType == "application/json"
                       || request.resource.contentType == "text/plain");
    }

    // Generated zip artifacts: Cloud Function만 쓰기. 누구나 읽기.
    match /artifacts/{datasetId}/{file=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
